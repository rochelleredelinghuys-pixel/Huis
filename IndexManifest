  async function load(){
    if(!isConfigured()){
      document.getElementById('setupOverlay').style.display = 'flex';
      setSyncBadge('err');
      state = defaultState();
      migrateState();
      render();
      return;
    }
    try{
      firebase.initializeApp(firebaseConfig);
      db = firebase.firestore();
      docRef = db.collection(DOC_PATH[0]).doc(DOC_PATH[1]);

      // Real-time listener: both phones stay in sync automatically
      docRef.onSnapshot(snap=>{
        if(snap.exists && snap.data().payload){
          isRemoteUpdate = true;
          try{ state = JSON.parse(snap.data().payload); }
          catch(e){ state = defaultState(); }
          migrateState();
          render();
        } else if(!firebaseReady){
          // first run, no document yet — seed it
          state = defaultState();
          migrateState();
          save();
          render();
        }
        firebaseReady = true;
        setSyncBadge('ok');
      }, err=>{
        console.error('sync error', err);
        setSyncBadge('err');
        if(!firebaseReady){
          state = defaultState();
          migrateState();
          render();
        }
      });
    }catch(e){
      console.error('firebase init failed', e);
      setSyncBadge('err');
      state = defaultState();
      migrateState();
      render();
    }
  }

  let saveTimer=null;
  function save(){
    if(isRemoteUpdate){ isRemoteUpdate = false; return; } // don't re-save what we just received
    if(!docRef) return;
    clearTimeout(saveTimer);
    saveTimer = setTimeout(async ()=>{
      try{
        await docRef.set({ payload: JSON.stringify(state), updatedAt: Date.now() });
        setSyncBadge('ok');
      }catch(e){
        console.error('save failed', e);
        setSyncBadge('err');
      }
    }, 300);
  }

