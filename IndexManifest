  // ---------- SPENDING TRENDS ----------
  function monthActuals(mk){
    const income = totalIncome();
    const billsPaidAmt = state.bills.filter(b=>b.paidMonth===mk).reduce((s,b)=>s+b.amount,0);
    const catSpent = totalSpent(mk);
    const spent = billsPaidAmt + catSpent;
    const saved = state.savings.filter(s=>s.method==='auto' || s.savedMonth===mk).reduce((s,x)=>s+x.amount,0);
    return {income, spent, saved};
  }
  function renderTrends(){
    const real = currentMonthKey();
    const months = [];
    for(let i=5;i>=0;i--) months.push(shiftMonthKey(real,-i));
    const data = months.map(mk=>({mk, ...monthActuals(mk)}));
    const maxVal = Math.max(1, ...data.map(d=>Math.max(d.income, d.spent, d.saved)));
    const chartW = 640, chartH = 240, groupW = chartW/data.length, barW = 22, barGap = 8;
    const scale = v => (v/maxVal) * (chartH-40);
    const bars = data.map((d,i)=>{
      const x0 = i*groupW + groupW/2 - barW - barGap/2;
      const spentH = scale(d.spent), savedH = scale(d.saved);
      const spentY = chartH-20-spentH, savedY = chartH-20-savedH;
      return `
        <rect x="${x0}" y="${spentY}" width="${barW}" height="${spentH}" fill="#b1492f" rx="3"></rect>
        <rect x="${x0+barW+barGap}" y="${savedY}" width="${barW}" height="${savedH}" fill="#4a5d45" rx="3"></rect>
        <text x="${x0+barW+barGap/2}" y="${chartH-4}" font-size="11" text-anchor="middle" fill="#645c4d" font-family="IBM Plex Mono, monospace">${monthTabLabel(d.mk)}</text>
      `;
    }).join('');
    const incomeY = chartH-20-scale(data[0].income);
    return `
    <div class="pin-card">
      <div class="section-title">Last 6 Months <span class="sub">income vs. spend vs. saved</span></div>
      <div style="display:flex;gap:16px;margin-bottom:10px;font-size:12px;color:var(--ink-soft);">
        <span><span style="display:inline-block;width:10px;height:10px;background:#b1492f;border-radius:2px;margin-right:5px;"></span>Spent (bills paid + category spend)</span>
        <span><span style="display:inline-block;width:10px;height:10px;background:#4a5d45;border-radius:2px;margin-right:5px;"></span>Saved</span>
        <span><span style="display:inline-block;width:14px;height:2px;background:#c99a3a;margin-right:5px;position:relative;top:-3px;"></span>Income (reference)</span>
      </div>
      <svg viewBox="0 0 ${chartW} ${chartH}" style="width:100%;height:auto;">
        <line x1="0" y1="${incomeY}" x2="${chartW}" y2="${incomeY}" stroke="#c99a3a" stroke-width="2" stroke-dasharray="6,4"></line>
        ${bars}
      </svg>
    </div>
    <div class="pin-card green">
      <div class="section-title">By The Numbers</div>
      <table>
        <thead><tr><th>Month</th><th>Income</th><th>Spent</th><th>Saved</th><th>Net</th></tr></thead>
        <tbody>
          ${data.map(d=>`<tr><td>${monthTabLabel(d.mk)}</td><td class="mono">${fmtMoney(d.income)}</td><td class="mono">${fmtMoney(d.spent)}</td><td class="mono">${fmtMoney(d.saved)}</td><td class="mono">${fmtMoney(d.income-d.spent-d.saved)}</td></tr>`).join('')}
        </tbody>
      </table>
    </div>`;
  }

