    let html = '';
    if(activeTab==='daily') html = renderDaily();
    else if(activeTab==='budget') html = renderBudget();
    else if(activeTab==='goals') html = renderGoals();
    else if(activeTab==='pantry') html = renderPantry();
    else if(activeTab==='shopping') html = renderShopping();
    else if(activeTab==='calendar') html = renderCalendar();
    else if(activeTab==='prep') html = renderPrep();
    else if(activeTab==='tasks') html = renderTasks();
