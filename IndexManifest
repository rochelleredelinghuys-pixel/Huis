  // ---------- MEAL IDEAS ----------
  function matchRecipe(r){
    const pantryNames = state.pantry.map(p=>p.name.toLowerCase());
    const have = r.ings.filter(ing => pantryNames.some(pn=>pn.includes(ing.toLowerCase())||ing.toLowerCase().includes(pn)));
    const missing = r.ings.filter(ing => !have.includes(ing));
    return {have, missing, pct: have.length/r.ings.length};
  }
  function findRecipeForMealText(text){
    const lower = text.trim().toLowerCase();
    if(!lower) return null;
    return RECIPES.find(r=>{
      const rn = r.name.toLowerCase();
      return rn===lower || lower.includes(rn) || rn.includes(lower);
    }) || null;
  }
  function plannedMealSummary(){
    const weekKeys = [0,1,2,3,4,5,6].map(i=>todayKey(i));
    const matchedMeals = []; // {slotText, recipe}
    const unmatchedMeals = [];
    weekKeys.forEach(k=>{
      const m = state.menu[k];
      if(!m) return;
      ['breakfast','lunch','dinner'].forEach(slot=>{
        const text = (m[slot]||'').trim();
        if(!text) return;
        const recipe = findRecipeForMealText(text);
        if(recipe) matchedMeals.push({text, recipe});
        else unmatchedMeals.push(text);
      });
    });
    const ingredientSet = new Set();
    matchedMeals.forEach(mm=>mm.recipe.ings.forEach(i=>ingredientSet.add(i)));
    return {matchedMeals, unmatchedMeals: [...new Set(unmatchedMeals)], ingredients:[...ingredientSet]};
  }
  function isIngredientCovered(ing){
    const lower = ing.toLowerCase();
    const inPantry = state.pantry.some(p=>{ const pn=p.name.toLowerCase(); return pn.includes(lower)||lower.includes(pn); });
    const inStaples = state.staples.some(s=>{ const sn=s.name.toLowerCase(); return sn.includes(lower)||lower.includes(sn); });
    return inPantry || inStaples;
  }
  function renderIdeas(){
    const scored = RECIPES.map(r=>({r, m:matchRecipe(r)})).sort((a,b)=>b.m.pct-a.m.pct);
    return `
    <div class="pin-card green">
      <div class="section-title">Meal Ideas From Your Pantry <span class="sub">${state.pantry.length} items on hand</span></div>
      ${state.pantry.length===0? '<div class="empty">Add a few pantry items first and I\'ll match them to recipes.</div>':''}
      ${scored.map(({r,m})=>{
        const badge = m.pct===1 ? '<span class="match-badge full">Ready to cook</span>' : m.pct>=0.5 ? `<span class="match-badge partial">${m.have.length}/${r.ings.length} on hand</span>` : `<span class="match-badge low">${m.have.length}/${r.ings.length} on hand</span>`;
        return `<div class="recipe-card">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;"><h4>${r.name}</h4>${badge}</div>
          <div class="ing-list">${r.ings.map(ing=>`<span class="ing-pill ${m.have.includes(ing)?'have':'miss'}">${ing}</span>`).join('')}</div>
          ${m.missing.length? `<button class="btn small ghost" data-add-missing='${JSON.stringify(m.missing)}'>Add missing to shopping list</button>` : ''}
        </div>`;
      }).join('')}
    </div>`;
  }

