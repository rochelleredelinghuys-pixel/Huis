  function migrateState(){
    const d = defaultState();
    Object.keys(d).forEach(k=>{ if(!(k in state)) state[k] = d[k]; });
    if(Array.isArray(state.savings)){
      state.savings.forEach(s=>{
        if(!('method' in s)) s.method = s.type==='investment' ? 'auto' : 'manual';
        if(!('savedMonth' in s)) s.savedMonth = null;
      });
    }
    if(Array.isArray(state.shopping)){
      state.shopping.forEach(i=>{
