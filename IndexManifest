  async function extractSlip(){
    if(!capturedSlip || !capturedSlip.imageBase64) return;
    try{
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body: JSON.stringify({
          model:"claude-sonnet-4-6",
          max_tokens:300,
          system:"You are extracting structured data from a photo of a grocery/shop receipt. Respond with ONLY a JSON object, no markdown fences, no preamble, no extra text. Format exactly: {\"total\": <number, the final total amount paid, no currency symbol, or null if unreadable>, \"store\": <string, store name if visible, else \"\">, \"date\": <string in YYYY-MM-DD format if a date is visible on the receipt, else null>}",
          messages:[
            { role:"user", content:[
              {type:"image", source:{type:"base64", media_type:capturedSlip.mediaType, data:capturedSlip.imageBase64}},
              {type:"text", text:"Extract the total, store name, and date from this receipt."}
            ]}
          ]
        })
      });
      const data = await response.json();
      const textBlock = (data.content||[]).find(c=>c.type==='text');
      const raw = textBlock ? textBlock.text : '';
      const clean = raw.replace(/```json|```/g,'').trim();
      const parsed = JSON.parse(clean);
      const total = (parsed.total!==null && parsed.total!==undefined && !isNaN(parsed.total)) ? Number(parsed.total) : null;
      capturedSlip.extracted = {
        total,
        store: parsed.store || '',
        date: (parsed.date && /^\d{4}-\d{2}-\d{2}$/.test(parsed.date)) ? parsed.date : new Date().toISOString().slice(0,10),
      };
      if(total===null){
        capturedSlip.status = 'ready';
        capturedSlip.errorMsg = null;
      } else {
        capturedSlip.status = 'ready';
      }
    }catch(e){
      capturedSlip.status = 'error';
      capturedSlip.errorMsg = "Couldn't read that receipt automatically — you can still enter the details manually below.";
      capturedSlip.extracted = {total:null, store:'', date:new Date().toISOString().slice(0,10)};
    }
    render();
  }

