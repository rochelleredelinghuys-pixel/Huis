<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Home Base</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#9CAF88">
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');

:root{
  --cork:#9CAF88;
  --card:#fbf7ee;
  --ink:#2e2a24;
  --ink-soft:#645c4d;
  --green:#4a5d45;
  --green-dark:#374530;
  --rust:#b1492f;
  --gold:#c99a3a;
  --line:#e4d9c0;
}
*{box-sizing:border-box;}

.hh-root{
  font-family:'Work Sans',sans-serif;
  background:var(--cork);
  background-image:
    radial-gradient(circle at 15% 20%, rgba(255,255,255,0.06) 0, transparent 40%),
    radial-gradient(circle at 85% 80%, rgba(0,0,0,0.06) 0, transparent 40%);
  color:var(--ink);
  min-height:100vh;
  padding:22px 16px 60px;
}
.hh-header{max-width:960px;margin:0 auto 18px;text-align:center;}
.hh-header .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--green-dark);opacity:.75;}
.hh-header h1{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(26px,4vw,38px);margin:4px 0 2px;}
.hh-header p{margin:0;color:var(--ink-soft);font-size:14px;}

.hh-nav{max-width:960px;margin:18px auto 20px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center;}
.hh-nav button{font-family:'Work Sans',sans-serif;font-weight:600;font-size:13px;padding:9px 15px;border-radius:999px;border:1.5px solid rgba(46,42,36,.22);background:rgba(251,247,238,.55);color:var(--ink);cursor:pointer;transition:all .15s ease;}
.hh-nav button:hover{background:rgba(251,247,238,.85);}
.hh-nav button.active{background:var(--ink);color:var(--card);border-color:var(--ink);}

.hh-main{max-width:960px;margin:0 auto;}
.panel{display:none;animation:fade .25s ease;}
.panel.active{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

.pin-card{background:var(--card);border-radius:2px;box-shadow:0 6px 14px rgba(0,0,0,.18), 0 1px 0 rgba(255,255,255,.4) inset;padding:20px 22px;position:relative;margin-bottom:18px;border:1px solid rgba(0,0,0,.05);transition:transform .25s ease, box-shadow .25s ease;}
.dash-grid .pin-card:hover{transform:translateY(-3px) rotate(-0.4deg);box-shadow:0 12px 20px rgba(0,0,0,.22), 0 1px 0 rgba(255,255,255,.4) inset;}
.dash-grid .pin-card:nth-child(3n+2){transform:rotate(0.4deg);}
.dash-grid .pin-card:nth-child(3n+2):hover{transform:translateY(-3px) rotate(0.9deg);}
.dash-grid .pin-card:nth-child(3n+3){transform:rotate(-0.3deg);}
.dash-grid .pin-card:nth-child(3n+3):hover{transform:translateY(-3px) rotate(-0.8deg);}
@keyframes shimmer{0%{background-position:0% 0;}100%{background-position:200% 0;}}
.progress-bar{background-image:linear-gradient(90deg, var(--green), #6b8563, var(--green));background-size:200% 100%;animation:shimmer 3s linear infinite;}
.progress-bar.over{background-image:linear-gradient(90deg, var(--rust), #d17a5f, var(--rust));}
.mood-banner{
  background:linear-gradient(135deg, #fbf7ee 0%, #f4ecd8 100%);
  border:1.5px dashed var(--gold);border-radius:12px;padding:16px 20px;margin-bottom:18px;
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
}
.mood-banner .mood-emoji{font-size:32px;line-height:1;flex-shrink:0;}
.mood-banner .mood-text{flex:1;min-width:200px;}
.mood-banner .mood-headline{font-family:'Fraunces',serif;font-weight:700;font-size:17px;margin:0 0 2px;color:var(--ink);}
.mood-banner .mood-sub{font-size:12.5px;color:var(--ink-soft);margin:0;}
.streak-badge{
  font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:12px;
  background:var(--green);color:#fff;padding:5px 12px;border-radius:999px;white-space:nowrap;
}
.fun-tagline{font-size:12.5px;font-style:italic;color:var(--ink-soft);margin-top:8px;}
.pin-card::before{content:'';position:absolute;top:-7px;left:50%;transform:translateX(-50%);width:12px;height:12px;border-radius:50%;background:radial-gradient(circle at 35% 30%, #e8b8a8, var(--rust));box-shadow:0 2px 3px rgba(0,0,0,.35);}
.pin-card.green::before{background:radial-gradient(circle at 35% 30%, #b9d0ae, var(--green));}
.pin-card.gold::before{background:radial-gradient(circle at 35% 30%, #f0dca0, var(--gold));}

.section-title{font-family:'Fraunces',serif;font-weight:600;font-size:20px;margin:0 0 14px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
.section-title .sub{font-family:'Work Sans',sans-serif;font-weight:400;font-size:12.5px;color:var(--ink-soft);}
.sub-heading{font-family:'Work Sans',sans-serif;font-weight:700;font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);margin:16px 0 8px;}

label{font-size:12px;font-weight:600;color:var(--ink-soft);display:block;margin-bottom:4px;text-transform:uppercase;letter-spacing:.03em;}
input,select{font-family:'Work Sans',sans-serif;font-size:14px;padding:8px 10px;border-radius:6px;border:1.5px solid var(--line);background:#fff;color:var(--ink);width:100%;}
input:focus,select:focus{outline:none;border-color:var(--green);}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
.row > div{flex:1;min-width:110px;}
.btn{font-family:'Work Sans',sans-serif;font-weight:600;font-size:13.5px;padding:8px 16px;border-radius:6px;border:none;cursor:pointer;background:var(--green);color:#fff;transition:background .15s;}
.btn:hover{background:var(--green-dark);}
.btn.rust{background:var(--rust);}
.btn.rust:hover{background:#8f3a24;}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink-soft);}
.btn.ghost:hover{border-color:var(--ink-soft);}
.btn.small{padding:5px 11px;font-size:12px;}
.btn.icon{padding:5px 10px;font-size:14px;line-height:1;}

table{width:100%;border-collapse:collapse;font-size:13.5px;}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);padding:6px 8px;border-bottom:1.5px solid var(--line);}
td{padding:8px;border-bottom:1px solid var(--line);}
tr:last-child td{border-bottom:none;}
.mono{font-family:'IBM Plex Mono',monospace;}

.progress-wrap{background:#efe7d4;border-radius:6px;height:10px;overflow:hidden;margin-top:6px;}
.progress-bar{height:100%;background:var(--green);border-radius:6px;transition:width .3s;}
.progress-bar.over{background:var(--rust);}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;}
.item-card{background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:10px 12px;position:relative;}
.item-card .dot{width:8px;height:8px;border-radius:50%;position:absolute;top:10px;right:10px;}
.item-card .dot.ok{background:var(--green);}
.item-card .dot.low{background:var(--rust);}
.item-card .name{font-weight:600;font-size:14px;margin-bottom:2px;padding-right:16px;}
.item-card .qty{font-size:12.5px;color:var(--ink-soft);font-family:'IBM Plex Mono',monospace;}
.item-card .del{position:absolute;bottom:8px;right:8px;font-size:11px;color:var(--ink-soft);cursor:pointer;background:none;border:none;}
.item-card .del:hover{color:var(--rust);}

.day-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.day-tabs button{font-family:'Work Sans',sans-serif;font-weight:600;font-size:12.5px;padding:6px 12px;border-radius:6px;border:1.5px solid var(--line);background:#fff;cursor:pointer;color:var(--ink-soft);}
.day-tabs button.active{background:var(--ink);color:#fff;border-color:var(--ink);}
.meal-slot{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.meal-slot .label{width:88px;font-weight:600;font-size:12.5px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.03em;}

.shop-item{display:flex;align-items:center;gap:10px;padding:8px 4px;border-bottom:1px solid var(--line);}
.shop-item:last-child{border-bottom:none;}
.shop-item input[type=checkbox]{width:auto;accent-color:var(--green);}
.shop-item.checked .txt{text-decoration:line-through;color:var(--ink-soft);}
.tag{font-size:10px;font-family:'IBM Plex Mono',monospace;background:var(--line);padding:2px 6px;border-radius:4px;color:var(--ink-soft);}

.recipe-card{background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:14px 16px;margin-bottom:12px;}
.recipe-card h4{font-family:'Fraunces',serif;margin:0 0 6px;font-size:17px;}
.ing-list{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0;}
.ing-pill{font-size:12px;padding:3px 9px;border-radius:999px;border:1.3px solid var(--line);}
.ing-pill.have{background:#eaf1e6;border-color:var(--green);color:var(--green-dark);}
.ing-pill.miss{background:#faeae5;border-color:var(--rust);color:var(--rust);}
.match-badge{font-family:'IBM Plex Mono',monospace;font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:6px;}
.match-badge.full{background:var(--green);color:#fff;}
.match-badge.partial{background:var(--gold);color:#3a2e0e;}
.match-badge.low{background:var(--line);color:var(--ink-soft);}

.empty{color:var(--ink-soft);font-size:13.5px;font-style:italic;padding:10px 0;}
.events-list{display:flex;flex-direction:column;gap:8px;}
.event-row{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:9px 12px;gap:8px;flex-wrap:wrap;}
.event-row .when{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--ink-soft);}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
@media(max-width:640px){.dash-grid{grid-template-columns:1fr;} .hh-root{padding:16px 10px 40px;}}
.stat{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;gap:8px;}
.stat .num{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:15px;white-space:nowrap;}
.hint{font-size:12px;color:var(--ink-soft);margin-top:8px;}

.month-switcher{display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
.month-nav-btn{
  font-family:'Work Sans',sans-serif;font-weight:600;font-size:13.5px;
  padding:9px 16px;border-radius:8px;border:1.5px solid var(--line);
  background:#f4ecd8;color:var(--ink-soft);cursor:pointer;transition:background .15s;
}
.month-nav-btn:hover{background:#ecdfc0;color:var(--ink);}
.month-nav-btn:disabled{opacity:.45;cursor:default;}
.month-nav-btn:disabled:hover{background:#f4ecd8;color:var(--ink-soft);}
.month-switcher-label{font-family:'Fraunces',serif;font-weight:700;font-size:24px;color:var(--ink);flex:1;text-align:center;min-width:150px;}
.month-picker-input{
  font-family:'Work Sans',sans-serif;font-size:14px;padding:8px 12px;border-radius:8px;
  border:1.5px solid var(--line);background:#fff;color:var(--ink);cursor:pointer;
}
.month-summary-title{font-family:'Fraunces',serif;font-weight:600;font-size:19px;margin:0 0 4px;}

.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.cal-head .month-label{font-family:'Fraunces',serif;font-weight:600;font-size:17px;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;}
.cal-dow{font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);text-align:center;font-weight:700;padding-bottom:4px;}
.cal-cell{background:#fff;border:1.5px solid var(--line);border-radius:6px;min-height:56px;padding:5px 6px;cursor:pointer;position:relative;font-size:12.5px;}
.cal-cell.other-month{opacity:.35;}
.cal-cell.today{border-color:var(--green);border-width:2px;}
.cal-cell.selected{background:var(--ink);color:#fff;}
.cal-cell .daynum{font-family:'IBM Plex Mono',monospace;font-weight:600;}
.cal-cell .dots{position:absolute;bottom:5px;left:6px;display:flex;gap:3px;}
.cal-cell .dots span{width:5px;height:5px;border-radius:50%;background:var(--rust);}
.cal-cell.selected .dots span{background:#f0dca0;}

.tasks-list{display:flex;flex-direction:column;gap:8px;}
.task-row{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:9px 12px;}
.task-row.done .txt{text-decoration:line-through;color:var(--ink-soft);}
.task-row input[type=checkbox]{width:auto;accent-color:var(--green);}
.assignee-pill{font-size:11px;font-weight:600;padding:3px 9px;border-radius:999px;white-space:nowrap;}
.assignee-pill.me{background:#eaf1e6;color:var(--green-dark);}
.assignee-pill.husband{background:#e6eef4;color:#2c4a5e;}
.assignee-pill.both{background:#f4e9d6;color:#7a5a1e;}

.prep-note{background:#fdf1e2;border:1.5px solid #ecd9b3;border-radius:8px;padding:12px 14px;font-size:13.5px;color:#5a4626;margin-bottom:14px;}
.prep-idea{background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:12px 14px;margin-bottom:10px;}
.prep-idea h4{font-family:'Fraunces',serif;margin:0 0 4px;font-size:15.5px;}
.prep-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;}
.prep-tag{font-size:10.5px;font-weight:600;padding:2px 8px;border-radius:999px;background:#eaf1e6;color:var(--green-dark);}

.sync-badge{
  position:fixed;top:10px;right:10px;z-index:50;
  font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:600;
  padding:5px 11px;border-radius:999px;background:rgba(251,247,238,.9);
  border:1.5px solid var(--line);color:var(--ink-soft);
}
.sync-badge.ok{color:var(--green-dark);border-color:var(--green);}
.sync-badge.err{color:var(--rust);border-color:var(--rust);}

.setup-overlay{
  position:fixed;inset:0;background:rgba(46,42,36,.85);z-index:100;
  display:flex;align-items:center;justify-content:center;padding:24px;
}
.setup-card{
  background:var(--card);border-radius:12px;padding:28px 30px;max-width:560px;width:100%;
  box-shadow:0 20px 50px rgba(0,0,0,.4);max-height:85vh;overflow-y:auto;
}
.setup-card h2{font-family:'Fraunces',serif;font-size:22px;margin:0 0 10px;}
.setup-card p{font-size:14px;line-height:1.6;color:var(--ink-soft);margin:0 0 14px;}
.setup-card code{background:#efe7d4;padding:2px 6px;border-radius:4px;font-family:'IBM Plex Mono',monospace;font-size:13px;}
.setup-card ol{padding-left:20px;font-size:14px;line-height:1.7;color:var(--ink);}
.setup-card a{color:var(--green-dark);}
</style>
</head>
