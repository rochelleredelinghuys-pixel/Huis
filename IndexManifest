  function wireEvents(){
    // Baby countdown
    const babyDue = document.getElementById('babyDueDate');
    if(babyDue) babyDue.onchange = ()=>{ state.baby.dueDate = babyDue.value; save(); render(); };
    document.querySelectorAll('[data-baby-check]').forEach(cb=>cb.onchange=()=>{
      const item = state.baby.checklist.find(i=>i.id===cb.dataset.babyCheck);
      if(item) item.checked = cb.checked; save(); render();
    });
    document.querySelectorAll('[data-del-baby]').forEach(b=>b.onclick=()=>{ state.baby.checklist = state.baby.checklist.filter(i=>i.id!==b.dataset.delBaby); save(); render(); });
    const addBabyItem = document.getElementById('addBabyItemBtn');
    if(addBabyItem) addBabyItem.onclick = ()=>{
      const category = document.getElementById('babyItemCat').value.trim() || 'Other';
      const name = document.getElementById('babyItemName').value.trim();
      if(!name) return;
      state.baby.checklist.push({id:uid(), category, name, checked:false});
      save(); render();
    };

    // Contacts
    document.querySelectorAll('[data-del-contact]').forEach(b=>b.onclick=()=>{ state.contacts = state.contacts.filter(c=>c.id!==b.dataset.delContact); save(); render(); });
    const addContact = document.getElementById('addContactBtn');
    if(addContact) addContact.onclick = ()=>{
      const name = document.getElementById('contactName').value.trim();
      const role = document.getElementById('contactRole').value.trim();
      const phone = document.getElementById('contactPhone').value.trim();
      const notes = document.getElementById('contactNotes').value.trim();
      if(!name) return;
      state.contacts.push({id:uid(), name, role, phone, notes});
      save(); render();
    };

    // Notes
    document.querySelectorAll('[data-del-note]').forEach(b=>b.onclick=()=>{ state.notes = state.notes.filter(n=>n.id!==b.dataset.delNote); save(); render(); });
    const addNote = document.getElementById('addNoteBtn');
    if(addNote) addNote.onclick = ()=>{
      const textEl = document.getElementById('noteText');
      const text = textEl.value.trim();
      const author = document.getElementById('noteAuthor').value;
      if(!text) return;
      state.notes.push({id:uid(), text, author, date:new Date().toISOString().slice(0,10)});
      save(); render();
    };

    // Backup & export
    const exportBtn = document.getElementById('exportDataBtn');
    if(exportBtn) exportBtn.onclick = ()=>{
      try{
        const blob = new Blob([JSON.stringify(state, null, 2)], {type:'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `household-hub-backup-${new Date().toISOString().slice(0,10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }catch(e){ console.error('export failed', e); }
    };
    const importFile = document.getElementById('importDataFile');
    if(importFile) importFile.onchange = (e)=>{
      const file = e.target.files[0];
      if(!file) return;
      const statusEl = document.getElementById('importStatus');
      const reader = new FileReader();
      reader.onload = ()=>{
        try{
          const parsed = JSON.parse(reader.result);
          if(typeof parsed !== 'object' || parsed===null) throw new Error('Not a valid backup file');
          state = parsed;
          const d = defaultState();
          Object.keys(d).forEach(k=>{ if(!(k in state)) state[k] = d[k]; });
          save();
          if(statusEl) statusEl.textContent = 'Restored successfully.';
          render();
        }catch(err){
          if(statusEl) statusEl.textContent = "That didn't look like a valid backup file — nothing was changed.";
        }
      };
      reader.readAsText(file);
    };

    // Goals
    document.querySelectorAll('[data-goal-start]').forEach(el=>el.onchange=()=>{
      const g = state.goals.find(g=>g.id===el.dataset.goalStart);
      if(g) g.startAmount = parseFloat(el.value)||0; save(); render();
    });
    document.querySelectorAll('[data-goal-target]').forEach(el=>el.onchange=()=>{
      const g = state.goals.find(g=>g.id===el.dataset.goalTarget);
      if(g) g.targetAmount = parseFloat(el.value)||0; save(); render();
    });
    document.querySelectorAll('[data-goal-monthly]').forEach(el=>el.onchange=()=>{
      const g = state.goals.find(g=>g.id===el.dataset.goalMonthly);
      if(g) g.monthlyAmount = parseFloat(el.value)||0; save(); render();
    });
    document.querySelectorAll('[data-del-goal]').forEach(b=>b.onclick=()=>{ state.goals = state.goals.filter(g=>g.id!==b.dataset.delGoal); save(); render(); });
    const addGoal = document.getElementById('addGoalBtn');
    if(addGoal) addGoal.onclick = ()=>{
      const name = document.getElementById('goalName').value.trim();
      const startAmount = parseFloat(document.getElementById('goalStart').value)||0;
      const targetAmount = parseFloat(document.getElementById('goalTarget').value)||0;
      const monthlyAmount = parseFloat(document.getElementById('goalMonthly').value)||0;
      if(!name || !targetAmount) return;
      state.goals.push({id:uid(), name, startAmount, targetAmount, monthlyAmount, contributions:{}});
      save(); render();
    };

    // Shop slip capture
    const slipFile = document.getElementById('slipFile');
    if(slipFile) slipFile.onchange = (e)=>{
      const file = e.target.files[0];
      if(!file) return;
      const reader = new FileReader();
      reader.onload = ()=>{
        const result = reader.result;
        const match = result.match(/^data:(.*);base64,(.*)$/);
        if(!match) return;
        capturedSlip = {imageBase64:match[2], mediaType:match[1], previewUrl:result, extracted:null, status:'idle', errorMsg:null};
        render();
      };
      reader.readAsDataURL(file);
    };
    const extractBtn = document.getElementById('extractSlipBtn');
    if(extractBtn) extractBtn.onclick = async ()=>{
      capturedSlip.status = 'loading';
      render();
      await extractSlip();
    };
    const logSlip = document.getElementById('logSlipBtn');
    if(logSlip) logSlip.onclick = ()=>{
      const store = document.getElementById('slipStore').value.trim();
      const date = document.getElementById('slipDate').value || new Date().toISOString().slice(0,10);
      const amount = parseFloat(document.getElementById('slipTotal').value);
      const category = document.getElementById('slipCategory').value;
      if(!amount || amount<=0) return;
      state.expenses.push({id:uid(), date, category, amount, note: store ? `Receipt — ${store}` : 'Receipt'});
      capturedSlip = null;
      save(); render();
    };
    const cancelSlip = document.getElementById('cancelSlipBtn');
    if(cancelSlip) cancelSlip.onclick = ()=>{ capturedSlip = null; render(); };

    const mPrev = document.getElementById('monthPrev');
    if(mPrev) mPrev.onclick = ()=>{ selectedMonth = shiftMonthKey(selectedMonth,-1); render(); };
    const mNext = document.getElementById('monthNext');
    if(mNext) mNext.onclick = ()=>{ selectedMonth = shiftMonthKey(selectedMonth,1); render(); };
    const mPicker = document.getElementById('monthPicker');
    if(mPicker) mPicker.onchange = ()=>{ if(mPicker.value) { selectedMonth = mPicker.value; render(); } };

    const qa = document.getElementById('quickAddShop');
    if(qa) qa.onclick = ()=>{
      state.pantry.filter(p=>p.qty<=p.low).forEach(p=>{
        if(!state.shopping.some(s=>s.name.toLowerCase()===p.name.toLowerCase() && !s.checked))
          state.shopping.push({id:uid(), name:p.name, checked:false, source:'pantry'});
      });
      save(); render();
    };

    // Income
    document.querySelectorAll('[data-income-name]').forEach(el=>el.onchange=()=>{
      const inc = state.income.find(i=>i.id===el.dataset.incomeName);
      if(inc) inc.name = el.value.trim()||inc.name; save();
    });
    document.querySelectorAll('[data-income-amt]').forEach(el=>el.onchange=()=>{
      const inc = state.income.find(i=>i.id===el.dataset.incomeAmt);
      if(inc) inc.amount = parseFloat(el.value)||0; save(); render();
    });
    document.querySelectorAll('[data-del-income]').forEach(b=>b.onclick=()=>{ state.income = state.income.filter(i=>i.id!==b.dataset.delIncome); save(); render(); });
    const addIncome = document.getElementById('addIncomeBtn');
    if(addIncome) addIncome.onclick = ()=>{
      const name = document.getElementById('incName').value.trim();
      const amount = parseFloat(document.getElementById('incAmt').value)||0;
      if(!name) return;
      state.income.push({id:uid(), name, amount}); save(); render();
    };

    // Savings & investments
    document.querySelectorAll('[data-sav-name]').forEach(el=>el.onchange=()=>{
      const s = state.savings.find(s=>s.id===el.dataset.savName);
      if(s) s.name = el.value.trim()||s.name; save();
    });
    document.querySelectorAll('[data-sav-amt]').forEach(el=>el.onchange=()=>{
      const s = state.savings.find(s=>s.id===el.dataset.savAmt);
      if(s) s.amount = parseFloat(el.value)||0; save(); render();
    });
    document.querySelectorAll('[data-del-sav]').forEach(b=>b.onclick=()=>{ state.savings = state.savings.filter(s=>s.id!==b.dataset.delSav); save(); render(); });
    document.querySelectorAll('[data-sav-method]').forEach(el=>el.onchange=()=>{
      const s = state.savings.find(s=>s.id===el.dataset.savMethod);
      if(s) s.method = el.value; save(); render();
    });
    document.querySelectorAll('[data-toggle-sav]').forEach(cb=>cb.onchange=()=>{
      const s = state.savings.find(s=>s.id===cb.dataset.toggleSav);
      if(s) s.savedMonth = cb.checked ? selectedMonth : null;
      save(); render();
    });
    const addSav = document.getElementById('addSavBtn');
    if(addSav) addSav.onclick = ()=>{
      const name = document.getElementById('savName').value.trim();
      const amount = parseFloat(document.getElementById('savAmt').value)||0;
      const type = document.getElementById('savType').value;
      const method = document.getElementById('savMethod').value;
      if(!name) return;
      state.savings.push({id:uid(), name, amount, type, method, savedMonth:null}); save(); render();
    };

    // Budget
    const mb = document.getElementById('monthlyBudget');
    if(mb) mb.onchange = ()=>{ state.budget.monthly = parseFloat(mb.value)||0; save(); render(); };
    const addCat = document.getElementById('addCatBtn');
    if(addCat) addCat.onclick = ()=>{
      const name = document.getElementById('catName').value.trim();
      const budget = parseFloat(document.getElementById('catBudget').value)||0;
      if(!name) return;
      state.budget.categories.push({name, budget}); save(); render();
    };
    const addExp = document.getElementById('addExpBtn');
    if(addExp) addExp.onclick = ()=>{
      const date = document.getElementById('expDate').value;
      const category = document.getElementById('expCat').value;
      const amount = parseFloat(document.getElementById('expAmt').value);
      const note = document.getElementById('expNote').value.trim();
      if(!date || !amount) return;
      state.expenses.push({id:uid(), date, category, amount, note}); save(); render();
    };
    document.querySelectorAll('[data-del-exp]').forEach(b=>b.onclick=()=>{ state.expenses = state.expenses.filter(e=>e.id!==b.dataset.delExp); save(); render(); });

    // Bills
    const addBill = document.getElementById('addBillBtn');
    if(addBill) addBill.onclick = ()=>{
      const name = document.getElementById('billName').value.trim();
      const amount = parseFloat(document.getElementById('billAmt').value)||0;
      const dueDay = parseInt(document.getElementById('billDay').value)||1;
      const type = document.getElementById('billType').value;
      if(!name) return;
      state.bills.push({id:uid(), name, amount, dueDay, type, paidMonth:null}); save(); render();
    };
    document.querySelectorAll('[data-toggle-bill]').forEach(cb=>cb.onchange=()=>{
      const bill = state.bills.find(b=>b.id===cb.dataset.toggleBill);
      if(bill) bill.paidMonth = cb.checked ? selectedMonth : null;
      save(); render();
    });
    document.querySelectorAll('[data-bill-type]').forEach(el=>el.onchange=()=>{
      const bill = state.bills.find(b=>b.id===el.dataset.billType);
      if(bill) bill.type = el.value; save(); render();
    });
    document.querySelectorAll('[data-del-bill]').forEach(b=>b.onclick=()=>{ state.bills = state.bills.filter(x=>x.id!==b.dataset.delBill); save(); render(); });

    // Pantry
    const addP = document.getElementById('addPantryBtn');
    if(addP) addP.onclick = ()=>{
      const name = document.getElementById('pName').value.trim();
      const qty = parseFloat(document.getElementById('pQty').value)||0;
      const unit = document.getElementById('pUnit').value.trim()||'ct';
      const low = parseFloat(document.getElementById('pLow').value)||0;
      if(!name) return;
      state.pantry.push({id:uid(), name, qty, unit, low}); save(); render();
    };
    document.querySelectorAll('[data-del-pantry]').forEach(b=>b.onclick=()=>{ state.pantry = state.pantry.filter(p=>p.id!==b.dataset.delPantry); save(); render(); });

    // Shopping
    const addShop = document.getElementById('addShopBtn');
    if(addShop) addShop.onclick = ()=>{
      const nameEl = document.getElementById('shopName');
      const name = nameEl.value.trim();
      if(!name) return;
      state.shopping.push({id:uid(), name, checked:false, source:'manual'}); nameEl.value=''; save(); render();
    };
    document.querySelectorAll('[data-check-shop]').forEach(cb=>cb.onchange=()=>{
      const item = state.shopping.find(i=>i.id===cb.dataset.checkShop);
      if(item) item.checked = cb.checked; save(); render();
    });
    document.querySelectorAll('[data-del-shop]').forEach(b=>b.onclick=()=>{ state.shopping = state.shopping.filter(i=>i.id!==b.dataset.delShop); save(); render(); });
    const clearChecked = document.getElementById('clearCheckedBtn');
    if(clearChecked) clearChecked.onclick = ()=>{ state.shopping = state.shopping.filter(i=>!i.checked); save(); render(); };

    // Calendar
    const calPrev = document.getElementById('calPrev');
    if(calPrev) calPrev.onclick = ()=>{ calMonthOffset--; render(); };
    const calNext = document.getElementById('calNext');
    if(calNext) calNext.onclick = ()=>{ calMonthOffset++; render(); };
    document.querySelectorAll('[data-cal-date]').forEach(c=>c.onclick=()=>{ selectedDate = c.dataset.calDate; render(); });
    const addEvent = document.getElementById('addEventBtn');
    if(addEvent) addEvent.onclick = ()=>{
      const time = document.getElementById('evTime').value;
      const title = document.getElementById('evTitle').value.trim();
      if(!title) return;
      state.events.push({id:uid(), date:selectedDate, time, title}); save(); render();
    };
    document.querySelectorAll('[data-del-event]').forEach(b=>b.onclick=()=>{ state.events = state.events.filter(e=>e.id!==b.dataset.delEvent); save(); render(); });
    document.querySelectorAll('[data-day]').forEach(b=>b.onclick=()=>{ activeDay = parseInt(b.dataset.day); render(); });
    const saveMenu = document.getElementById('saveMenuBtn');
    if(saveMenu) saveMenu.onclick = ()=>{
      const key = todayKey(activeDay);
      state.menu[key] = {
        breakfast: document.getElementById('mBreakfast').value.trim(),
        lunch: document.getElementById('mLunch').value.trim(),
        dinner: document.getElementById('mDinner').value.trim(),
      };
      save(); render();
    };

    // Meal prep
    const addPrep = document.getElementById('addPrepBtn');
    if(addPrep) addPrep.onclick = ()=>{
      const name = document.getElementById('prepName').value.trim();
      const date = document.getElementById('prepDate').value;
      const servings = parseInt(document.getElementById('prepServings').value)||1;
      const notes = document.getElementById('prepNotes').value.trim();
      if(!name || !date) return;
      state.mealPrep.push({id:uid(), name, date, servings, notes}); save(); render();
    };
    document.querySelectorAll('[data-del-prep]').forEach(b=>b.onclick=()=>{ state.mealPrep = state.mealPrep.filter(p=>p.id!==b.dataset.delPrep); save(); render(); });

    // Tasks
    const addTask = document.getElementById('addTaskBtn');
    if(addTask) addTask.onclick = ()=>{
      const name = document.getElementById('taskName').value.trim();
      const assignee = document.getElementById('taskAssignee').value;
      if(!name) return;
      state.tasks.push({id:uid(), name, assignee, done:false}); save(); render();
    };
    document.querySelectorAll('[data-toggle-task]').forEach(cb=>cb.onchange=()=>{
      const t = state.tasks.find(t=>t.id===cb.dataset.toggleTask);
      if(t) t.done = cb.checked; save(); render();
    });
    document.querySelectorAll('[data-del-task]').forEach(b=>b.onclick=()=>{ state.tasks = state.tasks.filter(t=>t.id!==b.dataset.delTask); save(); render(); });

    // Meal ideas
    document.querySelectorAll('[data-add-missing]').forEach(b=>b.onclick=()=>{
      const missing = JSON.parse(b.dataset.addMissing);
      missing.forEach(name=>{
        if(!state.shopping.some(s=>s.name.toLowerCase()===name.toLowerCase() && !s.checked))
          state.shopping.push({id:uid(), name, checked:false, source:'mealplan'});
      });
      save(); activeTab='shopping'; render();
    });

    // Monthly staples
    document.querySelectorAll('[data-staple-name]').forEach(el=>el.onchange=()=>{
      const s = state.staples.find(s=>s.id===el.dataset.stapleName);
      if(s) s.name = el.value.trim()||s.name; save();
    });
    document.querySelectorAll('[data-staple-qty]').forEach(el=>el.onchange=()=>{
      const s = state.staples.find(s=>s.id===el.dataset.stapleQty);
      if(s) s.qty = parseFloat(el.value)||0; save();
    });
    document.querySelectorAll('[data-staple-unit]').forEach(el=>el.onchange=()=>{
      const s = state.staples.find(s=>s.id===el.dataset.stapleUnit);
      if(s) s.unit = el.value.trim()||s.unit; save();
    });
    document.querySelectorAll('[data-del-staple]').forEach(b=>b.onclick=()=>{ state.staples = state.staples.filter(s=>s.id!==b.dataset.delStaple); save(); render(); });
    const addStaple = document.getElementById('addStapleBtn');
    if(addStaple) addStaple.onclick = ()=>{
      const name = document.getElementById('stapleName').value.trim();
      const qty = parseFloat(document.getElementById('stapleQty').value)||1;
      const unit = document.getElementById('stapleUnit').value.trim()||'ct';
      if(!name) return;
      state.staples.push({id:uid(), name, qty, unit}); save(); render();
    };
    const addAllStaples = document.getElementById('addAllStaplesBtn');
    if(addAllStaples) addAllStaples.onclick = ()=>{
      state.staples.forEach(s=>{
        const label = `${s.name} (${s.qty}${s.unit?' '+s.unit:''})`;
        if(!state.shopping.some(sh=>sh.name.toLowerCase()===s.name.toLowerCase() && !sh.checked))
          state.shopping.push({id:uid(), name:label, checked:false, source:'staple'});
      });
      save(); render();
    };

    // Meal-plan add-ons
    document.querySelectorAll('[data-add-planaddons]').forEach(b=>b.onclick=()=>{
      const addOns = JSON.parse(b.dataset.addPlanaddons);
      addOns.forEach(name=>{
        if(!state.shopping.some(s=>s.name.toLowerCase()===name.toLowerCase() && !s.checked))
          state.shopping.push({id:uid(), name, checked:false, source:'mealplan'});
      });
      save(); render();
    });
    const addAddon = document.getElementById('addAddonBtn');
    if(addAddon) addAddon.onclick = ()=>{
      const nameEl = document.getElementById('addonName');
      const name = nameEl.value.trim();
      if(!name) return;
      state.shopping.push({id:uid(), name, checked:false, source:'addon'});
      nameEl.value=''; save(); render();
    };
  }

  load();
})();
</script>
</body>
